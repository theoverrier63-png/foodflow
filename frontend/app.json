{
  "expo": {
    "name": "Leray-Pointel",
    "slug": "leray-pointel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leraypointel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.foodflow.qaug8m",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Importer des photos de produits et de bannières.",
        "NSPhotoLibraryAddUsageDescription": "Enregistrer les factures dans votre galerie.",
        "NSCameraUsageDescription": "Prendre une photo d'un produit à ajouter au catalogue."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.foodflow.qaug8m",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/feather",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Importer des photos de produits et de bannières.",
          "cameraPermission": "Prendre une photo d'un produit à ajouter au catalogue."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
